# ==========================================
# KAMU PERSONEL REHBERİ - ORTAM DEĞİŞKENLERİ
# ==========================================

# Uygulama Genel Ayarları
APP_NAME="Kamu Personel Rehberi"
APP_ENV="development"
DEBUG=True
SECRET_KEY="super-secret-key-change-me-in-production"

# Veritabanı (SQLite)
DATABASE_URL="sqlite:///./data/kamu.db"

# Yapay Zeka Motoru (Groq API)
# https://console.groq.com adresinden ücretsiz API anahtarı alınabilir.
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Telegram Bot & Kanal Entegrasyonu
# @BotFather üzerinden bot oluşturup token alınız.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# İlanların paylaşılacağı kanal ID'si veya kullanıcı adı (@kanal_adi)
TELEGRAM_CHANNEL_ID="@kamupersonelrehberi"

# Admin Paneli Güvenliği
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="kamu_secure_password_123"

# Görsel Şablon ve Çıktı Dizinleri
IMAGE_OUTPUT_DIR="./graphics/output"
ASSETS_DIR="./graphics/assets"
